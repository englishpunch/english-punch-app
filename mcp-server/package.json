{
  "name": "@english-punch/mcp-server",
  "version": "0.3.9",
  "description": "MCP server for English Punch — vocabulary learning tools",
  "type": "module",
  "bin": {
    "english-punch-mcp": "dist/index.js",
    "english-punch-mcp-http": "dist/http-index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "precopy": "rm -rf src/convex-generated",
    "copy": "cp -r ../convex/_generated src/convex-generated",
    "prebuild": "rm -rf dist && pnpm run copy",
    "build": "tsc -p tsconfig.build.json && cp -r src/convex-generated dist/convex-generated",
    "postbuild": "chmod +x dist/index.js dist/http-index.js",
    "start": "pnpm run copy && tsx src/index.ts",
    "start:http": "pnpm run copy && tsx src/http-index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "convex": "^1.44.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "~5.9.3"
  }
}
