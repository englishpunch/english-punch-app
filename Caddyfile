:80 {
	root * /srv
	encode zstd gzip

	@oauth_json path /.well-known/oauth-authorization-server /.well-known/openid-configuration /oauth/jwks
	header @oauth_json Content-Type "application/json; charset=utf-8"

	@oauth_actions path /oauth/token /oauth/device/code
	handle @oauth_actions {
		reverse_proxy https://ep-convex-site.echoja.com {
			header_up Host ep-convex-site.echoja.com
		}
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}" {err.status_code}
	}
}
